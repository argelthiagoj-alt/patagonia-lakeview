generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum AdminPlan {
  FREE
  PRO
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
  COMPLETED
}

enum PaymentProvider {
  CARD
  MERCADO_PAGO
}

enum PaymentStatus {
  SIMULATED_PENDING
  SIMULATED_APPROVED
  SIMULATED_CAPTURED
  SIMULATED_REFUNDED
  SIMULATED_FAILED
}

enum BedType {
  TWIN
  DOUBLE
  QUEEN
  KING
  SOFA_BED
  BUNK
}

enum AppealStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          UserRole  @default(USER)

  // Profile / billing
  phone       String?
  documentId  String?
  address     String?
  city        String?
  state       String?
  country     String?
  billingName String?

  // Ban
  isBanned   Boolean   @default(false)
  bannedAt   DateTime?
  banReason  String?
  bannedById String?

  // Admin plan (only meaningful for ADMIN)
  adminPlan AdminPlan @default(FREE)
  proUntil  DateTime?

  reservations           Reservation[]
  reviews                Review[]
  sessions               Session[]
  accounts               Account[]
  passwordResetCodes     PasswordResetCode[]
  emailVerificationCodes EmailVerificationCode[]
  ownedCabins            Cabin[]                 @relation("CabinOwner")
  sentMessages           Message[]               @relation("MessageSender")
  appealsFiled           ReviewAppeal[]          @relation("AppealAdmin")
  appealsResolved        ReviewAppeal[]          @relation("AppealResolvedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Linked external identity (Google, etc.). One row per (provider, providerAccountId).
model Account {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  email             String?
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model PasswordResetCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerificationCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Cabin {
  id               String   @id @default(cuid())
  slug             String   @unique
  title            String
  description      String
  shortDescription String?
  location         String
  lakeView         Boolean  @default(false)
  maxGuests        Int
  bedrooms         Int
  bathrooms        Int
  pricePerNight    Int
  cleaningFee      Int      @default(0)
  isActive         Boolean  @default(true)
  rating           Float    @default(5)
  reviewCount      Int      @default(0)
  highlights       String[] @default([])
  totalUnits       Int      @default(1)

  ownerId String
  owner   User   @relation("CabinOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  images       CabinImage[]
  amenities    CabinAmenity[]
  beds         CabinBed[]
  reservations Reservation[]
  reviews      Review[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([ownerId])
}

model CabinImage {
  id      String  @id @default(cuid())
  url     String
  alt     String?
  order   Int     @default(0)
  cabinId String
  cabin   Cabin   @relation(fields: [cabinId], references: [id], onDelete: Cascade)

  @@index([cabinId])
}

model Amenity {
  id     String         @id @default(cuid())
  key    String         @unique
  name   String
  icon   String?
  cabins CabinAmenity[]
}

model CabinAmenity {
  cabinId   String
  amenityId String
  cabin     Cabin   @relation(fields: [cabinId], references: [id], onDelete: Cascade)
  amenity   Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([cabinId, amenityId])
}

model CabinBed {
  id       String  @id @default(cuid())
  cabinId  String
  type     BedType
  quantity Int     @default(1)
  cabin    Cabin   @relation(fields: [cabinId], references: [id], onDelete: Cascade)

  @@unique([cabinId, type])
  @@index([cabinId])
}

model Reservation {
  id         String            @id @default(cuid())
  userId     String?
  cabinId    String
  guestName  String
  guestEmail String
  checkIn    DateTime
  checkOut   DateTime
  guests     Int
  totalPrice Int
  status     ReservationStatus @default(PENDING)
  notes      String?
  user       User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  cabin      Cabin             @relation(fields: [cabinId], references: [id], onDelete: Cascade)
  payment    Payment?
  conversation Conversation?
  review       Review?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([cabinId, checkIn, checkOut])
  @@index([userId])
}

/// Simulated payment. No real money is moved.
/// Card numbers are NEVER stored — we keep only last4 + brand.
model Payment {
  id            String          @id @default(cuid())
  reservationId String          @unique
  provider      PaymentProvider
  status        PaymentStatus   @default(SIMULATED_APPROVED)
  amount        Int
  currency      String          @default("ARS")
  cardBrand     String?
  last4         String?
  payerEmail    String?
  // Extended billing snapshot — keeps the simulated experience realistic
  billingName    String?
  documentId     String?
  phone          String?
  billingAddress String?
  city           String?
  state          String?
  country        String?
  simulated      Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
}

model Review {
  id            String   @id @default(cuid())
  userId        String
  cabinId       String
  reservationId String?  @unique
  rating        Int
  comment       String?
  isRemoved     Boolean  @default(false)
  removedReason String?
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cabin         Cabin    @relation(fields: [cabinId], references: [id], onDelete: Cascade)
  reservation   Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  appeals       ReviewAppeal[]
  createdAt     DateTime @default(now())

  @@index([cabinId])
  @@index([userId])
}

model ReviewAppeal {
  id           String       @id @default(cuid())
  reviewId     String
  adminId      String
  reason       String
  status       AppealStatus @default(PENDING)
  resolvedById String?
  resolution   String?
  resolvedAt   DateTime?
  createdAt    DateTime     @default(now())

  review     Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  admin      User   @relation("AppealAdmin", fields: [adminId], references: [id], onDelete: Cascade)
  resolvedBy User?  @relation("AppealResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([reviewId])
  @@index([status])
}

/// One conversation per reservation. Auto-created on first message.
model Conversation {
  id            String   @id @default(cuid())
  reservationId String   @unique
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  messages      Message[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
}
