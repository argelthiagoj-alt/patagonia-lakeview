generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum AdminPlan {
  FREE
  PRO
}

enum ReservationStatus {
  PENDING      // solicitud creada, esperando aprobación del anfitrión
  APPROVED    // anfitrión aprobó; esperando pago simulado del huésped
  CONFIRMED   // pago simulado capturado; reserva activa
  REJECTED
  CANCELLED
  COMPLETED
}

enum PaymentProvider {
  CARD
  MERCADO_PAGO
}

enum PaymentStatus {
  SIMULATED_PENDING
  SIMULATED_APPROVED
  SIMULATED_CAPTURED
  SIMULATED_REFUNDED
  SIMULATED_FAILED
}

enum BedType {
  TWIN
  DOUBLE
  QUEEN
  KING
  SOFA_BED
  BUNK
}

enum AppealStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PropertyType {
  CABIN  // hospedaje completo de un solo tipo, reservado como unidad
  HOTEL  // hospedaje multi-room, reservado por tipo de habitación
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          UserRole  @default(USER)

  // Profile / billing
  phone       String?
  documentId  String?
  address     String?
  city        String?
  state       String?
  country     String?
  billingName String?

  // Ban
  isBanned   Boolean   @default(false)
  bannedAt   DateTime?
  banReason  String?
  bannedById String?

  // Admin plan (only meaningful for ADMIN). Pago real NO se procesa —
  // la suscripción Pro es simulada (ver /admin/pro-membership).
  adminPlan AdminPlan @default(FREE)
  proSince  DateTime?
  proUntil  DateTime?

  reservations           Reservation[]
  reviews                Review[]
  sessions               Session[]
  accounts               Account[]
  passwordResetCodes     PasswordResetCode[]
  emailVerificationCodes EmailVerificationCode[]
  ownedCabins            Cabin[]                 @relation("CabinOwner")
  sentMessages           Message[]               @relation("MessageSender")
  appealsFiled           ReviewAppeal[]          @relation("AppealAdmin")
  appealsResolved        ReviewAppeal[]          @relation("AppealResolvedBy")
  favorites              Favorite[]              @relation("UserFavorites")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Linked external identity (Google, etc.). One row per (provider, providerAccountId).
model Account {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  email             String?
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model PasswordResetCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerificationCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Property: CABIN o HOTEL. El modelo sigue llamándose Cabin para no
/// romper imports existentes; "Cabin" es ahora "publicación".
model Cabin {
  id               String   @id @default(cuid())
  slug             String   @unique
  title            String
  description      String
  shortDescription String?
  location         String
  lakeView         Boolean  @default(false)
  maxGuests        Int
  bedrooms         Int
  bathrooms        Int
  pricePerNight    Int
  cleaningFee      Int      @default(0)
  isActive         Boolean  @default(true)
  rating           Float    @default(5)
  reviewCount      Int      @default(0)
  highlights       String[] @default([])
  totalUnits       Int      @default(1)

  // Marketplace
  propertyType PropertyType @default(CABIN)

  // Geolocalización (opcional). Si ambas son null, el mapa cae al link
  // genérico de búsqueda.
  latitude  Float?
  longitude Float?

  // Reglas / política de cancelación editables por el admin.
  cancellationPolicy String?
  houseRules         String?
  checkInTime        String? // ej. "15:00"
  checkOutTime       String? // ej. "11:00"

  // Datos del anfitrión visibles en la ficha (cabañas).
  hostDisplayName String?
  hostBio         String?
  hostPhoto       String?
  hostCity        String?
  hostingSince    DateTime?
  // Opcionales adicionales (no sensibles por default; el admin decide
  // mostrarlos al cargar valor).
  hostPhone       String?
  hostEmail       String?
  hostLink        String?

  // Datos institucionales del hotel (sólo para propertyType = HOTEL).
  // Se muestran como tarjeta institucional en vez de la tarjeta de
  // anfitrión personal. Null cuando la publicación es CABIN.
  hotelLegalName       String?
  hotelLogo            String?
  hotelDescription     String?
  hotelAddress         String?
  hotelCity            String?
  hotelPhone           String?
  hotelEmail           String?
  hotelWebsite         String?
  hotelReceptionHours  String?
  hotelGeneralPolicies String?

  // Features booleanas para filtros rápidos. Algunas aplican a cabañas
  // (TV, wifi, calefacción, AC, cobertura telefónica); el resto son
  // típicas de hoteles. Default false para no romper data existente.
  hasTv               Boolean @default(false)
  hasWifi             Boolean @default(false)
  hasHeating          Boolean @default(false)
  hasAirConditioning  Boolean @default(false)
  hasPhoneSignal      Boolean @default(false)
  hasRestaurant       Boolean @default(false)
  hasElevator         Boolean @default(false)
  has24hReception     Boolean @default(false)
  hasRoomService      Boolean @default(false)
  hasBreakfast        Boolean @default(false)
  hasSpa              Boolean @default(false)
  hasGym              Boolean @default(false)
  hasPool             Boolean @default(false)
  hasParking          Boolean @default(false)
  hasAccessibility    Boolean @default(false)

  ownerId String
  owner   User   @relation("CabinOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  images       CabinImage[]
  amenities    CabinAmenity[]
  beds         CabinBed[]
  roomTypes    RoomType[]
  reservations Reservation[]
  reviews      Review[]
  favoritedBy  Favorite[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([ownerId])
  @@index([propertyType])
}

model CabinImage {
  id      String  @id @default(cuid())
  url     String
  alt     String?
  order   Int     @default(0)
  cabinId String
  cabin   Cabin   @relation(fields: [cabinId], references: [id], onDelete: Cascade)

  @@index([cabinId])
}

model Amenity {
  id     String         @id @default(cuid())
  key    String         @unique
  name   String
  icon   String?
  cabins CabinAmenity[]
}

model CabinAmenity {
  cabinId   String
  amenityId String
  cabin     Cabin   @relation(fields: [cabinId], references: [id], onDelete: Cascade)
  amenity   Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([cabinId, amenityId])
}

model CabinBed {
  id       String  @id @default(cuid())
  cabinId  String
  type     BedType
  quantity Int     @default(1)
  cabin    Cabin   @relation(fields: [cabinId], references: [id], onDelete: Cascade)

  @@unique([cabinId, type])
  @@index([cabinId])
}

/// Para hoteles: tipos de habitación dentro de una publicación.
/// Cada RoomType define su propia capacidad, precio, inventario
/// (totalUnits) y camas.
model RoomType {
  id           String   @id @default(cuid())
  cabinId      String
  name         String
  description  String?
  pricePerNight Int
  maxGuests    Int
  totalUnits   Int     @default(1)
  /// Amenities específicos de este tipo de habitación, como array de
  /// keys libre. Mantiene el modelo simple; el filtro público se hace
  /// sobre las columnas booleanas del Cabin padre.
  amenities    String[] @default([])
  beds         RoomBed[]
  reservations Reservation[]
  cabin        Cabin   @relation(fields: [cabinId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([cabinId])
}

model RoomBed {
  id         String   @id @default(cuid())
  roomTypeId String
  type       BedType
  quantity   Int      @default(1)
  roomType   RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@unique([roomTypeId, type])
}

/// Favoritos del usuario sobre publicaciones (cabañas u hoteles).
model Favorite {
  userId    String
  cabinId   String
  createdAt DateTime @default(now())

  user  User  @relation("UserFavorites", fields: [userId], references: [id], onDelete: Cascade)
  cabin Cabin @relation(fields: [cabinId], references: [id], onDelete: Cascade)

  @@id([userId, cabinId])
  @@index([cabinId])
}

model Reservation {
  id         String            @id @default(cuid())
  userId     String?
  cabinId    String
  /// Para hoteles: qué tipo de habitación se reservó (null para CABIN).
  roomTypeId String?
  guestName  String
  guestEmail String
  checkIn    DateTime
  checkOut   DateTime
  guests     Int
  totalPrice Int
  status     ReservationStatus @default(PENDING)
  notes      String?
  user       User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  cabin      Cabin             @relation(fields: [cabinId], references: [id], onDelete: Cascade)
  roomType   RoomType?         @relation(fields: [roomTypeId], references: [id], onDelete: SetNull)
  payment    Payment?
  conversation Conversation?
  review       Review?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([cabinId, checkIn, checkOut])
  @@index([roomTypeId])
  @@index([userId])
}

/// Simulated payment. No real money is moved.
/// Card numbers are NEVER stored — we keep only last4 + brand.
model Payment {
  id            String          @id @default(cuid())
  reservationId String          @unique
  provider      PaymentProvider
  status        PaymentStatus   @default(SIMULATED_PENDING)
  amount        Int
  currency      String          @default("ARS")
  cardBrand     String?
  last4         String?
  payerEmail    String?
  // Extended billing snapshot — keeps the simulated experience realistic
  billingName    String?
  documentId     String?
  phone          String?
  billingAddress String?
  city           String?
  state          String?
  country        String?
  simulated      Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
}

model Review {
  id            String   @id @default(cuid())
  userId        String
  cabinId       String
  reservationId String?  @unique
  /// Rating general — promedio simple de las 6 categorías, calculado al
  /// crear la review. Se mantiene como columna física para no recalcular
  /// en cada query.
  rating        Int
  comment       String?
  isRemoved     Boolean  @default(false)
  removedReason String?

  /// Desglose 1-5 por categoría. Default 5 para reviews legacy creadas
  /// antes del split (que sólo tenían `rating`).
  ratingCleanliness   Int @default(5)
  ratingAccuracy      Int @default(5)
  ratingCheckin       Int @default(5)
  ratingCommunication Int @default(5)
  ratingLocation      Int @default(5)
  ratingValue         Int @default(5)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cabin         Cabin    @relation(fields: [cabinId], references: [id], onDelete: Cascade)
  reservation   Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  appeals       ReviewAppeal[]
  createdAt     DateTime @default(now())

  @@index([cabinId])
  @@index([userId])
}

model ReviewAppeal {
  id           String       @id @default(cuid())
  reviewId     String
  adminId      String
  reason       String
  status       AppealStatus @default(PENDING)
  resolvedById String?
  resolution   String?
  resolvedAt   DateTime?
  createdAt    DateTime     @default(now())

  review     Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  admin      User   @relation("AppealAdmin", fields: [adminId], references: [id], onDelete: Cascade)
  resolvedBy User?  @relation("AppealResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([reviewId])
  @@index([status])
}

/// One conversation per reservation. Auto-created on first message.
model Conversation {
  id            String   @id @default(cuid())
  reservationId String   @unique
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  messages      Message[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
}

/// Configuración editable del hero/landing por el SUPER_ADMIN.
/// Singleton: usamos siempre el row con id = "default". Si no existe,
/// la landing cae a las constantes hardcodeadas.
model LandingConfig {
  id                String   @id @default("default")
  heroTitle         String?
  heroSubtitle      String?
  heroCtaLabel      String?
  heroCtaHref       String?
  /// Por temporada: override de hero image url. JSON con shape
  /// { summer?: string; autumn?: string; winter?: string; spring?: string }.
  /// Si una clave falta, se usa la imagen default del módulo seasonal-theme.
  seasonalHeroes    Json?
  /// Texto destacado opcional bajo el subtitle.
  highlightText     String?
  /// Animación ambiental.
  atmosphereEnabled Boolean  @default(true)
  /// LOW | MEDIUM | HIGH — se interpreta en el cliente.
  atmosphereIntensity String @default("MEDIUM")
  /// URL de imagen fallback cuando la del hero falla.
  fallbackImage     String?
  updatedAt         DateTime @updatedAt
  updatedById       String?
}
