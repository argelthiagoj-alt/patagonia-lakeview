# ─── Patagonia Lakeview · variables de entorno ────────────────────────────
# Copiá este archivo como `.env` y completá con tus credenciales.
#
# La app funciona SIN base de datos: las páginas públicas usan datos mock.
# Login, registro, reset y verificación requieren DB real.


# ─── 1. Base de datos ─────────────────────────────────────────────────────
#
# Supabase (recomendado): necesitás DOS URLs distintas.
#   DATABASE_URL → pestaña "Transaction pooler" (puerto 6543) para runtime
#   DIRECT_URL  → "Session pooler" (puerto 5432) o "Direct connection" para migraciones
#
# DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-1-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-1-us-east-1.pooler.supabase.com:5432/postgres"
#
# Para Postgres local, usá la misma URL en ambas.
DATABASE_URL=
DIRECT_URL=


# ─── 2. Auth (sesión propia) ──────────────────────────────────────────────
# Generala con:
#   PowerShell: -join ((48..57) + (65..90) + (97..122) | Get-Random -Count 48 | % {[char]$_})
#   bash      : openssl rand -hex 32
AUTH_SECRET=
AUTH_COOKIE_NAME=pl_session


# ─── 3. App ───────────────────────────────────────────────────────────────
# IMPORTANTE: NEXT_PUBLIC_APP_URL debe coincidir EXACTAMENTE con el origin
# donde corre la app. Se usa para construir el redirect_uri de Google OAuth.
# Local: http://localhost:3000
# Prod : https://tu-dominio.vercel.app  (sin slash final)
NEXT_PUBLIC_APP_NAME=Patagonia Lakeview
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Si está en "true", el login muestra los botones "Entrar como demo" y habilita
# /api/auth/demo-login. En dev (NODE_ENV !== "production") está habilitado
# automáticamente sin importar esta variable.
NEXT_PUBLIC_DEMO_MODE=true


# ─── 4. Email (Resend) ────────────────────────────────────────────────────
# Si dejás RESEND_API_KEY vacío, los códigos se loguean en consola en dev.
#   1. Crear cuenta gratis en https://resend.com
#   2. API Keys → Create → copiar
#   3. Verificar tu dominio en "Domains" (o usar onboarding@resend.dev por defecto)
#
# EMAIL_FROM debe ser un remitente verificado. Si no, usá la default de Resend.
RESEND_API_KEY=
EMAIL_FROM="Patagonia Lakeview <onboarding@resend.dev>"

# Email destinatario para postulaciones de "Trabajá con nosotros".
# Si no se configura, se usa la dirección de EMAIL_FROM (o se loguea en consola
# si tampoco está). En prod siempre poné un email real del equipo.
COMPANY_CONTACT_EMAIL=


# ─── 5. Google OAuth ──────────────────────────────────────────────────────
# 1. https://console.cloud.google.com → "APIs & Services" → "Credentials"
# 2. Crear "OAuth client ID" tipo "Web application"
# 3. Authorized JavaScript origins:
#       http://localhost:3000
#       https://tu-dominio.vercel.app
# 4. Authorized redirect URIs (MUY IMPORTANTE):
#       http://localhost:3000/api/auth/google/callback
#       https://tu-dominio.vercel.app/api/auth/google/callback
# 5. Configurar el OAuth consent screen (Test users mientras esté "Testing")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
